<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPApp.Pages.RsvpPage"
             Title="RSVP">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label x:Name="EventTitleLabel" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

            <Entry x:Name="NameEntry" Placeholder="Your Name" />
            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
            <Entry x:Name="GuestsEntry" Placeholder="# of Guests" Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="{StaticResource Secondary}" TextColor="{StaticResource Primary}" />
                <Button Text="Save" Clicked="OnSaveClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
